# Copy to .env and adjust. Every value is optional for the local demo.

# ── chain ──
RPC_URL=http://127.0.0.1:8545
# Deployer key for testnets (local deploy uses Anvil account #0)
# PRIVATE_KEY=0x...
# Testnet role holders onboarded by scripts/deploy.js
# ORACLE_ADDRESS=0x...
# PROVIDER_ADDRESS=0x...
# INSTITUTION_ADDRESS=0x...

# ── server ──
PORT=3000
# Oracle signer (local default = Anvil account #9)
# ORACLE_PRIVATE_KEY=0x...
# Enables GET /api/oracle/subject/:address for the Chainlink Functions DON (leave empty to disable)
# ORACLE_API_TOKEN=
# 32-byte hex key for vault encryption (local default = auto-generated data/.vault-dev-key)
# VAULT_MASTER_KEY=

# ── real-time screening ──
# local = bundled fictional watchlist, ofac = live US Treasury SDN list, opensanctions = live API (sanctions + PEPs)
SCREENING_SOURCES=local,ofac
# Free key for non-commercial use: https://www.opensanctions.org/api/
# OPENSANCTIONS_API_KEY=
OFAC_REFRESH_HOURS=24
MATCH_THRESHOLD=0.92
# Perpetual KYC: how often the oracle re-screens every valid customer (0 = off)
RESCREEN_INTERVAL_MIN=30
